# ── Dependencies ──
node_modules/

# ── Build artifacts ──
dist/
out/
build/
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.snap
*.blockmap

# ── Platform-specific FFmpeg binaries ──
# (Replit uses system ffmpeg from Nix instead)
src/bin/ffmpeg-darwin*
src/bin/ffmpeg.exe

# ── Signing & certificates ──
*.p12
*.p8
*.cer
*.pem
*.key
*.provisionprofile

# ── Local icon backup from the PokitPlayer -> MaidenPlayer rebrand ──
.icon-backup-pokit/

# ── macOS artifacts ──
.DS_Store
*.app/

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Replit ──
.cache/
.config/
.upm/
.local/
replit_zip_error_log.txt

# ── Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── Environment ──
.env
.env.local
.env.production

# Local test media — large binaries, not part of the app
FOOTAGE/

# ── Blackmagic RAW SDK (vendored, not redistributable via git) ──
# Download it from Blackmagic and unpack into native/braw-decode/sdk/.
# See native/braw-decode/README.md.
native/braw-decode/sdk/
native/braw-decode/build/
# ── Blackmagic DeckLink SDK, for SDI output ──
# The headers are COMMITTED (native/sdi-out/sdk) — Blackmagic's licence in
# every file grants redistribution, and having them in-tree is what lets CI
# build sdi-out with no download. Only build output is ignored here.
native/sdi-out/build/
src/bin/sdi-out
src/bin/sdi-out.exe
# The installer downloads themselves — ~174 MB, and sdk/ already holds what
# the build needs.
native/*.zip
native/*.dmg
native/*.msi
src/bin/braw-decode
src/bin/braw-decode.exe
src/bin/BlackmagicRawAPI.framework/
src/bin/BlackmagicRawAPI.dll
