<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Inherited by child processes (Electron helpers, ffmpeg subprocess) -->

    <!-- Required for Electron helper processes (GPU, renderer, etc.) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Required for V8 in renderer/utility processes -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required for spawned ffmpeg processes -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Inherit file access from parent process -->
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
